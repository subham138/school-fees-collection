<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-label">Total Students</div>
            <div class="stat-value"><%= typeof totalStudents !== 'undefined' ? totalStudents : 0 %></div>
        </div>
        <div class="stat-icon primary">
            <i class='bx bx-group'></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-label">Active Agents</div>
            <div class="stat-value"><%= typeof activeAgents !== 'undefined' ? activeAgents : 0 %></div>
        </div>
        <div class="stat-icon info">
            <i class='bx bx-user-pin'></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-label">Total Collected</div>
            <div class="stat-value">₹<%= typeof totalCollected !== 'undefined' ? Number(totalCollected).toLocaleString('en-IN') : 0 %></div>
        </div>
        <div class="stat-icon success">
            <i class='bx bx-wallet'></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-label">Pending Uploads</div>
            <div class="stat-value"><%= typeof pendingUploads !== 'undefined' ? pendingUploads : 0 %></div>
        </div>
        <div class="stat-icon warning">
            <i class='bx bx-upload'></i>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <h3 class="card-title mb-3">Collections Overview (Last 7 Days)</h3>
            <div style="height: 300px; width: 100%;">
                <canvas id="collectionsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="card-title mb-0">Recent Transactions</h3>
                <span class="badge bg-light text-primary border border-primary-subtle px-2.5 py-1.5" style="font-size: 11px;">Live updates</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0" style="font-size: 14px;">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase; color: var(--text-muted);">
                            <th class="border-bottom-0 py-3">Trans No</th>
                            <th class="border-bottom-0 py-3">Agent</th>
                            <th class="border-bottom-0 py-3 text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof recentTransactions !== 'undefined' && recentTransactions.length > 0) { %>
                            <% recentTransactions.forEach(function(txn) { %>
                                <tr>
                                    <td class="fw-semibold"><%= txn.agent_trans_no %></td>
                                    <td><%= txn.agent_name %></td>
                                    <td class="fw-semibold text-success text-end">+₹<%= Number(txn.deposit_amount).toLocaleString('en-IN') %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No recent transactions found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chartDataRaw = <%- typeof chartData !== 'undefined' ? chartData : '[]' %>;
    
    // Prepare data for Chart.js
    const labels = chartDataRaw.map(item => {
        const date = new Date(item.transaction_date);
        return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
    });
    const data = chartDataRaw.map(item => item.amount);

    const ctx = document.getElementById('collectionsChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Total Collections (₹)',
                data: data,
                borderColor: '#4f46e5',
                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                borderWidth: 2,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#4f46e5',
                pointRadius: 4,
                pointHoverRadius: 6,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return '₹' + Number(context.raw).toLocaleString('en-IN');
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: '#f3f4f6',
                        drawBorder: false
                    },
                    ticks: {
                        callback: function(value) {
                            return '₹' + Number(value).toLocaleString('en-IN');
                        }
                    }
                },
                x: {
                    grid: {
                        display: false,
                        drawBorder: false
                    }
                }
            }
        }
    });
});
</script>
